<?xml version="1.0" encoding="utf-8"?>
<permissions>
    <!-- Permissions for MiuiCamera -->
    <privapp-permissions package="com.android.camera">
        <permission name="android.permission.INTERACT_ACROSS_USERS"/>
        <permission name="android.permission.MANAGE_USB"/>
        <permission name="android.permission.START_TASKS_FROM_RECENTS"/>
        <permission name="android.permission.START_ACTIVITIES_FROM_BACKGROUND"/>
        <permission name="android.permission.DUMP"/>
        <permission name="android.permission.WRITE_MEDIA_STORAGE"/>
        <permission name="android.permission.LOG_COMPAT_CHANGE"/>
        <permission name="android.permission.TURN_SCREEN_ON"/>
        <permission name="android.permission.SUBSCRIBE_TO_KEYGUARD_LOCKED_STATE"/>
        <permission name="android.permission.READ_COMPAT_CHANGE_CONFIG"/>
        <permission name="android.permission.WRITE_SECURE_SETTINGS"/>
        <permission name="android.permission.SYSTEM_CAMERA"/>
    </privapp-permissions>

    <!-- Permissions for com.miui.extraphoto -->
    <privapp-permissions package="com.miui.extraphoto">
        <permission name="android.permission.READ_EXTERNAL_STORAGE"/>
        <permission name="android.permission.WRITE_EXTERNAL_STORAGE"/>
        <permission name="android.permission.ACCESS_MEDIA_LOCATION"/>
        <permission name="android.permission.READ_MEDIA_AUDIO"/>
        <permission name="android.permission.READ_MEDIA_VIDEO"/>
        <permission name="android.permission.READ_MEDIA_IMAGES"/>
        <permission name="android.permission.WRITE_MEDIA_AUDIO"/>
        <permission name="android.permission.WRITE_MEDIA_VIDEO"/>
        <permission name="android.permission.WRITE_MEDIA_IMAGES"/>
        <permission name="android.permission.MANAGE_EXTERNAL_STORAGE"/>
    </privapp-permissions>
</permissions>